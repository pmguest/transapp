---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import WaitlistForm from '../components/WaitlistForm.astro';

const stakes = [
	{
		title: 'A contract clause',
		body: 'One mistranslated term and an agreement means something different in each language it was signed in.',
	},
	{
		title: 'A drug interaction warning',
		body: 'Precision that gets lost crossing from English into Spanish doesn’t announce itself. It just stops protecting anyone.',
	},
	{
		title: 'A safety instruction',
		body: 'On a vessel, in a warehouse, on a factory floor — an instruction that says the opposite of what it meant to say.',
	},
];

const beliefs = [
	{
		title: 'Meaning is not negotiable',
		body: 'A translation isn’t a word-for-word substitution. It’s a promise that the meaning, the intention, the tone — even the humour — survives the crossing into another language, another culture, another reader’s mind.',
	},
	{
		title: 'No single mind gets the final word',
		body: 'Not because AI is bad — because no single mind, human or artificial, should be trusted alone with something consequential. That’s not a limitation of the technology. It’s just how accountability works.',
	},
	{
		title: 'Speed and verification aren’t opposites',
		body: 'Throwing it all at AI and shipping is reckless. Verifying everything by hand is a luxury most businesses can’t afford. The only serious answer is to build verification into the speed — not bolt it on after.',
	},
];

const mechanism = [
	{
		title: 'Three models, one consensus',
		body: 'Not one AI translating in isolation — three, working independently, then cross-examining each other’s drafts until they converge on a consensus instead of a guess.',
	},
	{
		title: 'Glossaries that are yours',
		body: 'Terms you mandate. Terms you forbid. The language your industry, your brand, or your regulator requires stays exactly as you need it — every time, not the machine’s best guess.',
	},
	{
		title: 'Memory that holds the line',
		body: 'Your standard phrases stay consistent across every document, every project, every language pair — instead of getting reinvented on a whim each time.',
	},
	{
		title: 'A human gateway',
		body: 'A real person, real accountability, standing between anything contractual, regulated, or critical and the moment it reaches your client or the public. Nothing ships blind.',
	},
];

const testimonials = [
	{
		quote:
			'We used to have a bilingual staffer proofread every AI draft by hand because we didn’t trust it. The consensus pass caught two clause-level mismatches in our first contract before she even opened the file.',
		name: 'Early access tester',
		role: 'Operations lead, mid-sized logistics company',
	},
	{
		quote:
			'The glossary lock is the whole thing for us. Our regulator-mandated terms finally stay put instead of drifting between drafts.',
		name: 'Early access tester',
		role: 'Regulatory affairs manager, medical device manufacturer',
	},
	{
		quote:
			'It’s the first AI translation workflow where I didn’t feel like I was gambling on the output. Someone actually stands behind it.',
		name: 'Early access tester',
		role: 'Founder, boutique translation agency',
	},
];

const pricing = [
	{
		name: 'Starter',
		price: '$39',
		period: '/mo',
		description: 'For small teams sending the occasional document that has to be right.',
		features: [
			'Up to 20,000 words / month',
			'Three-model consensus on every draft',
			'One glossary, unlimited terms',
			'Email support',
		],
		cta: 'Join the waitlist',
		featured: false,
	},
	{
		name: 'Business',
		price: '$149',
		period: '/mo',
		description: 'For companies with regulated, contractual, or brand-critical content.',
		features: [
			'Up to 150,000 words / month',
			'Three-model consensus on every draft',
			'Unlimited glossaries & shared memory',
			'Human gateway review on flagged content',
			'Priority support',
		],
		cta: 'Join the waitlist',
		featured: true,
	},
	{
		name: 'Enterprise',
		price: 'Let’s talk',
		period: '',
		description: 'For organizations that need a dedicated review team and compliance sign-off.',
		features: [
			'Custom volume',
			'Dedicated human reviewers',
			'Compliance & audit trail',
			'SSO and custom integrations',
		],
		cta: 'Contact us',
		featured: false,
	},
];
---

<Layout>
	<Nav />

	<main id="top">
		<!-- Hero -->
		<section class="relative overflow-hidden px-6 pt-20 pb-24 sm:pt-28 sm:pb-32">
			<div class="mx-auto max-w-3xl text-center">
				<p
					class="mx-auto mb-6 inline-flex items-center gap-2 rounded-full border border-seal/30 bg-seal/10 px-4 py-1.5 text-sm font-medium text-seal"
				>
					<span class="h-1.5 w-1.5 rounded-full bg-seal"></span>
					AI translation, verified
				</p>
				<h1 class="font-serif text-4xl font-semibold leading-tight tracking-tight text-ink sm:text-5xl md:text-6xl">
					AI can translate your document in seconds.
					<span class="text-seal">Nobody’s checking if it’s right.</span>
				</h1>
				<p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft">
					transapp runs every translation through three independent AI models that
					cross-check each other, a glossary that stays yours and not the machine’s, and
					a human gateway for anything that matters — before it ever reaches your client.
				</p>
				<div class="mt-10 flex flex-col items-center gap-3">
					<WaitlistForm align="center" />
					<p class="text-xs text-ink-soft/70">
						Founding-tier pricing for early signups. No spam — just launch updates.
					</p>
				</div>
			</div>
		</section>

		<!-- The lie -->
		<section class="border-y border-line/70 bg-paper-dim px-6 py-20 sm:py-28">
			<div class="mx-auto max-w-4xl">
				<h2 class="font-serif text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
					The lie no one wants to say out loud
				</h2>
				<p class="mt-6 text-lg leading-relaxed text-ink-soft">
					Everyone tells you AI translation is “basically as good as a human now.”
					That’s a lie. Not because the models are stupid — they’re extraordinary —
					but because <span class="font-medium text-ink">nobody is checking their work.</span>
					These aren’t hypotheticals. They’re what happens, quietly, every single day,
					inside businesses that traded a careful human process for a fast, ungoverned one —
					and never noticed the difference until it cost them.
				</p>
				<p class="mt-4 text-lg leading-relaxed text-ink-soft">We noticed. Because it happened to us.</p>

				<div class="mt-12 grid gap-6 sm:grid-cols-3">
					{
						stakes.map((item) => (
							<div class="rounded-lg border border-line bg-paper p-6 shadow-sm">
								<p class="font-serif text-lg font-semibold text-ink">{item.title}</p>
								<p class="mt-2 text-sm leading-relaxed text-ink-soft">{item.body}</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- Founder story -->
		<section id="story" class="px-6 py-20 sm:py-28">
			<div class="mx-auto max-w-4xl">
				<h2 class="font-serif text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
					Built by someone the AI came for
				</h2>
				<p class="mt-6 text-lg leading-relaxed text-ink-soft">
					transapp wasn’t dreamed up in a boardroom by people who’d never translated a
					word in their lives. It was built by a career linguist and communication strategist
					who spent decades doing this work by hand — first as a translator, then running
					his own translation business from the ground up, working the kind of hours that
					build a career and wreck a back. Then, almost overnight, AI wiped most of it out.
				</p>
				<p class="mt-4 text-lg leading-relaxed text-ink-soft">
					That could have been the end of the story. Instead, we asked a harder question:
				</p>
				<blockquote class="mt-8 border-l-4 border-seal py-2 pl-6">
					<p class="font-serif text-2xl italic leading-snug text-ink">
						“If AI is going to translate the world’s documents whether we like it or
						not, who’s making sure it does it right?”
					</p>
					<p class="mt-3 text-sm font-medium text-ink-soft">The answer, almost everywhere, was: no one.</p>
				</blockquote>
			</div>
		</section>

		<!-- What we believe -->
		<section class="border-y border-line/70 bg-ink px-6 py-20 text-paper sm:py-28">
			<div class="mx-auto max-w-5xl">
				<h2 class="font-serif text-3xl font-semibold tracking-tight sm:text-4xl">What we believe</h2>
				<p class="mt-4 max-w-2xl text-lg leading-relaxed text-paper/70">
					We refuse the false choice everyone keeps offering — throw it all at AI and ship
					it, or reject AI and trust only humans. Both are wrong.
				</p>
				<div class="mt-12 grid gap-8 sm:grid-cols-3">
					{
						beliefs.map((item) => (
							<div>
								<p class="font-serif text-xl font-semibold text-seal-light">{item.title}</p>
								<p class="mt-3 text-sm leading-relaxed text-paper/70">{item.body}</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- How we do it -->
		<section id="how" class="px-6 py-20 sm:py-28">
			<div class="mx-auto max-w-5xl">
				<h2 class="font-serif text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
					How we actually do it
				</h2>
				<p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-soft">
					Nothing ships blind. Nothing ships unchecked. That’s not a feature — that’s
					the whole point.
				</p>
				<div class="mt-12 grid gap-6 sm:grid-cols-2">
					{
						mechanism.map((item) => (
							<div class="rounded-lg border border-line bg-paper-dim p-6">
								<p class="font-serif text-lg font-semibold text-ink">{item.title}</p>
								<p class="mt-2 text-sm leading-relaxed text-ink-soft">{item.body}</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- Testimonials -->
		<section class="border-y border-line/70 bg-paper-dim px-6 py-20 sm:py-28">
			<div class="mx-auto max-w-5xl">
				<h2 class="font-serif text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
					What early testers are saying
				</h2>
				<div class="mt-12 grid gap-6 sm:grid-cols-3">
					{
						testimonials.map((t) => (
							<figure class="flex flex-col justify-between rounded-lg border border-line bg-paper p-6 shadow-sm">
								<blockquote class="text-sm leading-relaxed text-ink-soft">“{t.quote}”</blockquote>
								<figcaption class="mt-6">
									<p class="text-sm font-semibold text-ink">{t.name}</p>
									<p class="text-xs text-ink-soft/70">{t.role}</p>
								</figcaption>
							</figure>
						))
					}
				</div>
			</div>
		</section>

		<!-- Pricing -->
		<section id="pricing" class="px-6 py-20 sm:py-28">
			<div class="mx-auto max-w-5xl">
				<div class="text-center">
					<h2 class="font-serif text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
						Priced for businesses that can’t afford either extreme
					</h2>
					<p class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-ink-soft">
						Not the cost of a purely manual process. Not the risk of a purely automated one.
					</p>
				</div>
				<div class="mt-12 grid gap-6 sm:grid-cols-3">
					{
						pricing.map((tier) => (
							<div
								class:list={[
									'flex flex-col rounded-xl border p-8',
									tier.featured
										? 'border-seal bg-ink text-paper shadow-lg sm:-translate-y-2'
										: 'border-line bg-paper-dim text-ink',
								]}
							>
								{tier.featured && (
									<p class="mb-4 inline-block w-fit rounded-full bg-seal px-3 py-1 text-xs font-semibold text-ink">
										Most popular
									</p>
								)}
								<p class="font-serif text-xl font-semibold">{tier.name}</p>
								<p class="mt-4 flex items-baseline gap-1">
									<span class="text-3xl font-semibold">{tier.price}</span>
									<span class={tier.featured ? 'text-paper/60' : 'text-ink-soft/70'}>{tier.period}</span>
								</p>
								<p class={`mt-3 text-sm leading-relaxed ${tier.featured ? 'text-paper/70' : 'text-ink-soft'}`}>
									{tier.description}
								</p>
								<ul class="mt-6 flex-1 space-y-3 text-sm">
									{tier.features.map((f) => (
										<li class="flex items-start gap-2">
											<span class={tier.featured ? 'text-seal-light' : 'text-seal'}>✓</span>
											<span class={tier.featured ? 'text-paper/80' : 'text-ink-soft'}>{f}</span>
										</li>
									))}
								</ul>
								<a
									href="#waitlist"
									class:list={[
										'mt-8 block rounded-md px-4 py-2.5 text-center text-sm font-medium transition',
										tier.featured
											? 'bg-seal text-ink hover:bg-seal-light'
											: 'bg-ink text-paper hover:bg-seal',
									]}
								>
									{tier.cta}
								</a>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- Mission -->
		<section class="border-y border-line/70 bg-paper-dim px-6 py-20 sm:py-28">
			<div class="mx-auto max-w-4xl">
				<h2 class="font-serif text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
					This is not just an app
				</h2>
				<p class="mt-6 text-lg leading-relaxed text-ink-soft">
					We’re not building a translation tool because translation is a nice little niche
					market. We’re building it because translation is the sharpest possible proof of a
					much bigger idea: that AI-generated content — documents, contracts, drafts,
					anything that carries real consequences — deserves the same discipline. Verified
					facts. Verified citations. A human check on anything that matters, before it goes out
					into the world.
				</p>
				<p class="mt-4 text-lg leading-relaxed text-ink-soft">
					Translation is where we’re starting because the stakes are concrete and the
					failures are checkable — a wrong word is a wrong word, a broken clause is a broken
					clause. If we can prove AI and human judgment work together properly, at a price and
					speed any business can use, this becomes the model for how all AI-assisted
					communication should work. Not humans replaced. Not AI rejected. A discipline, built
					once, applied everywhere.
				</p>
				<p class="mt-4 font-serif text-xl italic text-ink">This is step one.</p>
			</div>
		</section>

		<!-- Final CTA -->
		<section id="waitlist" class="px-6 py-20 sm:py-28">
			<div class="mx-auto max-w-2xl text-center">
				<h2 class="font-serif text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
					Join us
				</h2>
				<p class="mt-6 text-lg leading-relaxed text-ink-soft">
					If you’ve ever hesitated before hitting “send” on an AI-translated
					document because some part of you didn’t quite trust it — you were right not
					to. That instinct is correct, and it deserves better tools than “just trust the
					model.”
				</p>
				<p class="mt-4 text-lg leading-relaxed text-ink-soft">
					We built transapp for exactly that instinct. Come build the discipline with us. It
					starts here.
				</p>
				<div class="mt-10 flex justify-center">
					<WaitlistForm align="center" />
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Layout>
