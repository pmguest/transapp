---
import Layout from '../layouts/Layout.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import VariationSwitcher from '../components/VariationSwitcher.astro';

const navLinks = [
	{ href: '#mechanism', label: 'How it works' },
	{ href: '#pricing', label: 'Pricing' },
];

const problems = [
	{
		tag: '[01]',
		title: 'A contract clause',
		body: 'Two signatures, two languages, one agreement — supposedly. If the model drifted on a single clause, the parties never actually agreed to the same terms.',
	},
	{
		tag: '[02]',
		title: 'A drug interaction warning',
		body: 'Invert one qualifier in a dosage note and the sentence still reads fluently. Nothing in the output tells you it now means the opposite.',
	},
	{
		tag: '[03]',
		title: 'A safety instruction',
		body: 'Printed on a factory floor or a job site, a mistranslated warning doesn’t get flagged, doesn’t get questioned, and doesn’t get a second attempt.',
	},
];

const mechanism = [
	{
		num: '[01]',
		title: 'Three-model consensus',
		body: 'Every document is translated independently by three separate AI models. They cross-check each other’s drafts and converge on one answer — not one model’s unverified guess.',
	},
	{
		num: '[02]',
		title: 'Glossaries, locked',
		body: 'Mandated terms. Forbidden terms. The exact vocabulary your industry or your regulator requires, held fixed on every document, in every language pair, every time.',
	},
	{
		num: '[03]',
		title: 'Persistent translation memory',
		body: 'Standard phrases resolve identically across your entire document set, instead of being reworded at random depending on which model touched the sentence.',
	},
	{
		num: '[04]',
		title: 'Human review gateway',
		body: 'Contractual, regulated, or high-stakes content is routed to a real reviewer before it reaches your client. Nothing that matters ships without a human signature.',
	},
];

const testimonials = [
	{
		quote:
			'The consensus pass flagged two clause-level mismatches in our first contract run — before anyone on our side had even opened the file.',
		name: 'Operations lead',
		role: 'Logistics company',
	},
	{
		quote:
			'Our regulator-mandated terminology finally stays locked from draft to draft to final. That alone was worth the switch.',
		name: 'Regulatory affairs manager',
		role: 'Medical device manufacturer',
	},
	{
		quote:
			'First AI translation pipeline I’ve run where I’m not gambling on the output. A human still checks the file before it leaves the building.',
		name: 'Founder',
		role: 'Boutique translation agency',
	},
];

const pricing = [
	{
		name: 'Starter',
		price: '$39',
		period: '/mo',
		description: 'For teams sending the occasional document that has to hold up.',
		features: ['Up to 20,000 words / month', 'Consensus run on every draft', 'One glossary', 'Email support'],
		featured: false,
	},
	{
		name: 'Business',
		price: '$149',
		period: '/mo',
		description: 'For companies moving regulated, contractual, or brand-critical volume.',
		features: [
			'Up to 150,000 words / month',
			'Unlimited glossaries & shared memory',
			'Human gateway review on flagged content',
			'Priority support',
		],
		featured: true,
	},
	{
		name: 'Enterprise',
		price: 'Let’s talk',
		period: '',
		description: 'For organizations that need dedicated reviewers and a signed audit trail.',
		features: ['Custom volume', 'Dedicated human reviewers', 'Compliance & audit trail', 'SSO'],
		featured: false,
	},
];
---

<Layout
	title="transapp — Cipher"
	description="AI document translation that gets independently verified before it ships. Three-model consensus, locked glossaries, persistent translation memory, and a human review gateway for anything that matters."
	noindex={true}
>
	<div class="bg-[#0a0e14] font-sans text-[#e4e4e7] [color-scheme:dark]">
		<!-- Header -->
		<header class="border-b border-white/10 bg-[#0a0e14]">
			<div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5">
				<a
					href="#top"
					class="flex items-center gap-2 font-['Space_Grotesk',sans-serif] text-lg font-bold uppercase tracking-widest text-[#e4e4e7]"
				>
					<span class="text-[#22d3a8]">&gt;</span>
					transapp<span class="text-[#22d3a8] animate-pulse">_</span>
				</a>
				<nav aria-label="Primary" class="hidden items-center gap-8 sm:flex">
					{
						navLinks.map((link) => (
							<a
								href={link.href}
								class="font-mono text-sm text-[#a1a1aa] transition hover:text-[#22d3a8]"
							>
								{link.label}
							</a>
						))
					}
				</nav>
				<a
					href="#waitlist"
					class="border border-[#22d3a8] px-4 py-2 font-mono text-sm font-medium text-[#22d3a8] transition hover:bg-[#22d3a8] hover:text-[#0a0e14] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#22d3a8] focus-visible:ring-offset-2 focus-visible:ring-offset-[#0a0e14]"
				>
					[ request_access ]
				</a>
			</div>
		</header>

		<main id="top">
			<!-- Hero -->
			<section
				class="relative overflow-hidden border-b border-white/10 px-6 pb-24 pt-20 sm:pb-32 sm:pt-28"
				style="background-image: radial-gradient(rgba(228,228,231,0.09) 1px, transparent 1px); background-size: 22px 22px;"
			>
				<div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-[#0a0e14]"></div>
				<div class="relative mx-auto max-w-4xl">
					<p class="mb-6 inline-flex items-center gap-2 border border-[#22d3a8]/40 px-3 py-1 font-mono text-xs uppercase tracking-widest text-[#22d3a8]">
						<span class="text-[#22d3a8]">$</span>
						status: unverified_by_default
					</p>
					<h1 class="font-['Space_Grotesk',sans-serif] text-4xl font-bold uppercase leading-[1.08] tracking-tight text-[#e4e4e7] sm:text-5xl md:text-6xl">
						AI translates in seconds.<br />
						<span class="text-[#22d3a8]">Nothing checks its work.</span>
					</h1>
					<p class="mt-8 max-w-2xl text-lg leading-relaxed text-[#a1a1aa] sm:text-xl">
						transapp runs every document through three independent models that cross-check each
						other, glossaries that hold your terms exactly where you put them, and a human
						gateway for anything that matters — before a single word reaches your client.
					</p>
					<div class="mt-10">
						<WaitlistForm align="left" />
						<p class="mt-3 font-mono text-xs text-[#71717a]">
							// founding-tier pricing for early signups — no spam, launch updates only
						</p>
					</div>
				</div>
			</section>

			<!-- Problem -->
			<section class="border-b border-white/10 bg-[#0d1220] px-6 py-20 sm:py-28">
				<div class="mx-auto max-w-5xl">
					<p class="mb-3 flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-[#71717a]">
						<span class="text-[#22d3a8]">$</span> the_problem
					</p>
					<h2 class="max-w-2xl font-['Space_Grotesk',sans-serif] text-2xl font-bold uppercase tracking-tight text-[#e4e4e7] sm:text-3xl">
						Fast and unverified is not a feature
					</h2>
					<p class="mt-6 max-w-2xl text-lg leading-relaxed text-[#a1a1aa]">
						Businesses ship AI-translated contracts, regulatory text, and safety instructions
						every day without anyone checking the model’s output. Most runs are fine. The failure
						mode is that you can’t tell which run wasn’t — until it costs you.
					</p>
					<div class="mt-14 grid gap-px overflow-hidden border border-white/10 bg-white/10 sm:grid-cols-3">
						{
							problems.map((item) => (
								<div class="bg-[#0d1220] p-8">
									<p class="font-mono text-sm text-[#22d3a8]">{item.tag}</p>
									<p class="mt-3 font-['Space_Grotesk',sans-serif] text-lg font-bold uppercase tracking-tight text-[#e4e4e7]">
										{item.title}
									</p>
									<p class="mt-3 text-sm leading-relaxed text-[#a1a1aa]">{item.body}</p>
								</div>
							))
						}
					</div>
				</div>
			</section>

			<!-- How it works -->
			<section id="mechanism" class="border-b border-white/10 bg-[#0a0e14] px-6 py-20 sm:py-28">
				<div class="mx-auto max-w-5xl">
					<p class="mb-3 flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-[#71717a]">
						<span class="text-[#22d3a8]">$</span> how_it_works
					</p>
					<h2 class="max-w-2xl font-['Space_Grotesk',sans-serif] text-2xl font-bold uppercase tracking-tight text-[#e4e4e7] sm:text-3xl">
						Four checkpoints between the model and your client
					</h2>
					<div class="mt-14 grid gap-8 sm:grid-cols-2">
						{
							mechanism.map((item) => (
								<div class="border-l-2 border-[#22d3a8] pl-6">
									<p class="font-mono text-sm text-[#71717a]">{item.num}</p>
									<p class="mt-2 font-['Space_Grotesk',sans-serif] text-xl font-bold uppercase tracking-tight text-[#e4e4e7]">
										{item.title}
									</p>
									<p class="mt-3 text-sm leading-relaxed text-[#a1a1aa]">{item.body}</p>
								</div>
							))
						}
					</div>
				</div>
			</section>

			<!-- Founder story -->
			<section class="border-b border-white/10 bg-[#0d1220] px-6 py-20 sm:py-28">
				<div class="mx-auto max-w-3xl">
					<p class="mb-3 flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-[#71717a]">
						<span class="text-[#22d3a8]">$</span> why_we_built_this
					</p>
					<h2 class="font-['Space_Grotesk',sans-serif] text-2xl font-bold uppercase tracking-tight text-[#e4e4e7] sm:text-3xl">
						Built by the person AI displaced
					</h2>
					<p class="mt-6 text-lg leading-relaxed text-[#a1a1aa]">
						transapp was started by a career linguist and translator who watched his own
						translation business get upended by AI in a matter of months. He didn’t reject the
						technology, and he didn’t trust it blindly the way most of the industry has started
						to. He built the verification layer his own profession never had — the layer that
						should have shipped with the model in the first place.
					</p>
				</div>
			</section>

			<!-- Testimonials -->
			<section class="border-b border-white/10 bg-[#0a0e14] px-6 py-20 sm:py-28">
				<div class="mx-auto max-w-5xl">
					<p class="mb-3 flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-[#71717a]">
						<span class="text-[#22d3a8]">$</span> early_access_log
					</p>
					<h2 class="max-w-2xl font-['Space_Grotesk',sans-serif] text-2xl font-bold uppercase tracking-tight text-[#e4e4e7] sm:text-3xl">
						What early testers are saying
					</h2>
					<div class="mt-14 grid gap-6 sm:grid-cols-3">
						{
							testimonials.map((t) => (
								<figure class="flex flex-col justify-between border border-white/10 bg-[#0d1220] p-6">
									<blockquote class="font-mono text-sm leading-relaxed text-[#e4e4e7]">
										<span class="text-[#22d3a8]">&gt; </span>
										{t.quote}
									</blockquote>
									<figcaption class="mt-6 border-t border-white/10 pt-4">
										<p class="text-sm font-semibold text-[#e4e4e7]">{t.name}</p>
										<p class="font-mono text-xs text-[#71717a]">{t.role}</p>
									</figcaption>
								</figure>
							))
						}
					</div>
				</div>
			</section>

			<!-- Pricing -->
			<section id="pricing" class="border-b border-white/10 bg-[#0d1220] px-6 py-20 sm:py-28">
				<div class="mx-auto max-w-5xl">
					<div class="max-w-2xl">
						<p class="mb-3 flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-[#71717a]">
							<span class="text-[#22d3a8]">$</span> pricing
						</p>
						<h2 class="font-['Space_Grotesk',sans-serif] text-2xl font-bold uppercase tracking-tight text-[#e4e4e7] sm:text-3xl">
							Priced for teams that can’t afford to guess
						</h2>
					</div>
					<div class="mt-14 grid gap-6 sm:grid-cols-3">
						{
							pricing.map((tier) => (
								<div
									class:list={[
										'flex flex-col bg-[#0a0e14] p-8',
										tier.featured ? 'border-2 border-[#22d3a8] sm:-translate-y-3' : 'border border-white/10',
									]}
								>
									{tier.featured && (
										<p class="mb-4 inline-block w-fit border border-[#22d3a8] px-3 py-1 font-mono text-xs uppercase tracking-widest text-[#22d3a8]">
											[ most_popular ]
										</p>
									)}
									<p class="font-['Space_Grotesk',sans-serif] text-xl font-bold uppercase tracking-tight text-[#e4e4e7]">
										{tier.name}
									</p>
									<p class="mt-4 flex items-baseline gap-1">
										<span class="font-['Space_Grotesk',sans-serif] text-4xl font-bold text-[#e4e4e7]">
											{tier.price}
										</span>
										<span class="font-mono text-[#71717a]">{tier.period}</span>
									</p>
									<p class="mt-3 text-sm leading-relaxed text-[#a1a1aa]">{tier.description}</p>
									<ul class="mt-6 flex-1 space-y-3 text-sm">
										{tier.features.map((f) => (
											<li class="flex items-start gap-2">
												<span class="mt-1.5 h-1.5 w-1.5 shrink-0 bg-[#22d3a8]" />
												<span class="text-[#a1a1aa]">{f}</span>
											</li>
										))}
									</ul>
									<a
										href="#waitlist"
										class:list={[
											'mt-8 block border px-4 py-3 text-center font-mono text-sm font-medium transition focus:outline-none focus-visible:ring-2 focus-visible:ring-[#22d3a8] focus-visible:ring-offset-2 focus-visible:ring-offset-[#0a0e14]',
											tier.featured
												? 'border-[#22d3a8] bg-[#22d3a8] text-[#0a0e14] hover:bg-[#2dd4bf]'
												: 'border-white/20 text-[#e4e4e7] hover:border-[#22d3a8] hover:text-[#22d3a8]',
										]}
									>
										{tier.name === 'Enterprise' ? '[ contact_sales ]' : '[ request_access ]'}
									</a>
								</div>
							))
						}
					</div>
				</div>
			</section>

			<!-- Final CTA -->
			<section id="waitlist" class="bg-[#0a0e14] px-6 py-20 sm:py-28">
				<div class="mx-auto max-w-2xl text-center">
					<p class="mb-3 flex items-center justify-center gap-2 font-mono text-xs uppercase tracking-widest text-[#71717a]">
						<span class="text-[#22d3a8]">$</span> get_started
					</p>
					<h2 class="font-['Space_Grotesk',sans-serif] text-2xl font-bold uppercase tracking-tight text-[#e4e4e7] sm:text-3xl">
						Verify before it ships
					</h2>
					<p class="mt-6 text-lg leading-relaxed text-[#a1a1aa]">
						If you’ve ever paused before sending an AI-translated document because something felt
						unchecked, that instinct was correct. Join the waitlist and be first to run
						translations that are actually verified.
					</p>
					<div class="mt-10 flex justify-center">
						<WaitlistForm align="center" />
					</div>
				</div>
			</section>
		</main>

		<!-- Footer -->
		<footer class="border-t border-white/10 bg-[#080b10] px-6 py-16">
			<div class="mx-auto flex max-w-6xl flex-col items-center gap-10">
				<div class="flex items-center gap-2 font-['Space_Grotesk',sans-serif] text-lg font-bold uppercase tracking-widest text-[#e4e4e7]">
					<span class="text-[#22d3a8]">&gt;</span>
					transapp<span class="text-[#22d3a8]">_</span>
				</div>
				<VariationSwitcher />
				<p class="font-mono text-xs text-[#71717a]">&copy; {new Date().getFullYear()} transapp. All rights reserved.</p>
			</div>
		</footer>
	</div>
</Layout>
