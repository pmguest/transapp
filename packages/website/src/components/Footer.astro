---
import VariationSwitcher from './VariationSwitcher.astro';
---

<footer class="border-t border-line/70 bg-paper-dim">
	<div class="mx-auto max-w-6xl px-6 py-12">
		<div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
			<div>
				<p class="font-serif text-lg font-semibold text-ink">transapp</p>
				<p class="mt-1 max-w-sm text-sm text-ink-soft">
					Translation that gets checked — by three models, your glossary, and a human who's
					accountable for the result.
				</p>
			</div>
			<div class="flex gap-6 text-sm text-ink-soft">
				<a href="#story" class="hover:text-ink">Our story</a>
				<a href="#how" class="hover:text-ink">How it works</a>
				<a href="#pricing" class="hover:text-ink">Pricing</a>
			</div>
		</div>
		<div class="mt-10 flex justify-center border-t border-line/70 pt-8">
			<VariationSwitcher />
		</div>
		<p class="mt-8 text-xs text-ink-soft/70">
			© {new Date().getFullYear()} transapp. All rights reserved.
		</p>
	</div>
</footer>
