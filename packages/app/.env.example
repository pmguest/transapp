# Copy to .env and fill in — see README.md.
# Never commit .env (already gitignored).

# Supabase project (Settings -> API in the Supabase dashboard).
# VITE_-prefixed because these two are read client-side by src/lib/supabase.ts —
# Vite only exposes VITE_* env vars to the browser bundle.
VITE_SUPABASE_PROJECT_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Direct Postgres connection password (Settings -> Database). Not used by
# @supabase/supabase-js / src/lib/supabase.ts — keep this unprefixed so it
# never ends up in the client bundle.
SUPABASE_PROJECT_PASSWORD=
